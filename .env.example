# ── Contacto / envío de emails (Gmail SMTP con App Password) ──────
# 1. En tu cuenta de Google activa la Verificación en 2 pasos.
# 2. Crea una "Contraseña de aplicación": https://myaccount.google.com/apppasswords
# 3. Pega aquí el correo y la contraseña de 16 caracteres (sin espacios).
SMTP_FROM_EMAIL="tu-correo@gmail.com"
SMTP_APP_PASSWORD="xxxxxxxxxxxxxxxx"

# Destinatario principal del formulario (separar por coma si son varios)
CONTACT_TO=jukopila.giovanny15@gmail.com
# Destinatarios en copia (CC)
CONTACT_CC=jukopila.yango@gmail.com

# ════════════════════════════════════════════════════════════════
#  Herramienta interna de prospección (Juko Prospect)
# ════════════════════════════════════════════════════════════════

# ── Base de datos (Postgres vía Docker; ver docker-compose.yml) ──
# Por defecto apunta al contenedor local en el puerto 5433.
DATABASE_URL="postgres://juko:juko_dev_pw@localhost:5433/juko_prospect"

# ── Google APIs ──────────────────────────────────────────────────
# Una sola key puede servir para ambas si habilitas las dos APIs en
# Google Cloud Console:
#   - Places API           (búsqueda de negocios)
#   - PageSpeed Insights API (auditoría de velocidad/SEO)
# Cómo obtenerla: console.cloud.google.com → crea proyecto →
#   "APIs & Services" → habilita ambas → "Credentials" → API key.
GOOGLE_MAPS_API_KEY=""
# Opcional: key separada solo para PageSpeed. Si se deja vacía, se usa GOOGLE_MAPS_API_KEY.
PAGESPEED_API_KEY=""

# ── Anthropic (Claude) — Fase 2 (agentes de marketing) ───────────
# console.anthropic.com → API Keys. Modelo por defecto: Sonnet 4.6.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ── Operación ────────────────────────────────────────────────────
# Días antes de recomendar refrescar una zona ya evaluada.
DEFAULT_REFRESH_DAYS=90
# ── Autenticación (login del panel) ──────────────────────────────
# Rellena AMBAS para activar el login. Si se dejan vacías, el panel queda abierto
# (cómodo en local). En el servidor desplegado, SIEMPRE configúralas.
#   AUTH_USERS:  pares usuario:contraseña separados por coma
#   AUTH_SECRET: cadena larga aleatoria para firmar la cookie de sesión
#                (genera una con: openssl rand -base64 32)
AUTH_USERS="gio:123456,hermano:123456"
AUTH_SECRET=""

# Config dir del CLI de Claude para los agentes (fija la cuenta/suscripción, ej ~/.claude-personal)
# CLAUDE_CLI_CONFIG_DIR="/Users/tu-usuario/.claude-personal"
